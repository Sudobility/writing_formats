{
  "name": "@sudobility/writing_formats",
  "version": "0.1.6",
  "description": "File-format import/export for Fadewright: Fountain, Final Draft (.fdx) and Fade In (.fadein) to and from writing_core's DocumentJSON, with conversion reports",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./fountain-classify": {
      "types": "./dist/fountain/classify.d.ts",
      "import": "./dist/fountain/classify.js",
      "default": "./dist/fountain/classify.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "build": "tsc -p tsconfig.esm.json",
    "clean": "rimraf dist",
    "verify": "bun run typecheck && bun run test:unit && bun run build",
    "prepublishOnly": "bun run clean && bun run verify"
  },
  "files": [
    "dist/**/*",
    "CLAUDE.md"
  ],
  "keywords": [
    "screenwriting",
    "fountain",
    "fdx",
    "final-draft",
    "fade-in",
    "fadewright"
  ],
  "author": "Sudobility",
  "license": "BUSL-1.1",
  "dependencies": {
    "@sudobility/writing_core": "^0.1.5",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "rimraf": "^6.0.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/writing_formats.git"
  }
}
